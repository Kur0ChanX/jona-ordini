rules_version = '2';
// Regole del database di Jona Ordini (da incollare in Firebase > Firestore Database > Regole).
// Entra solo chi ha la chiave del ristorante (link o QR condiviso dallo chef o dallo sviluppatore)
// e il cui telefono è stato approvato da un telefono già approvato («ok» falso = in attesa; senza «ok» = approvato).
service cloud.firestore {
  match /databases/{db}/documents {
    function membro() {
      return request.auth != null
        && exists(/databases/$(db)/documents/membri/$(request.auth.uid))
        && get(/databases/$(db)/documents/membri/$(request.auth.uid)).data.get('ok', true) != false;
    }
    // entrata libera (v40): un gestore la apre per 48 ore in pubblico/porta {fino}
    function portaAperta() {
      return exists(/databases/$(db)/documents/pubblico/porta)
        && get(/databases/$(db)/documents/pubblico/porta).data.get('fino', 0) > request.time.toMillis();
    }
    // invito monouso (v40): inviti/<gettone> {sid, fino}; il gettone lungo nel link è il segreto
    function invitoBuono(tk) {
      return tk is string && tk.size() >= 20
        && exists(/databases/$(db)/documents/inviti/$(tk))
        && get(/databases/$(db)/documents/inviti/$(tk)).data.fino > request.time.toMillis();
    }
    // gettone usato in questa stessa scrittura dal telefono che entra
    function mioInvito() {
      return request.auth != null
        && getAfter(/databases/$(db)/documents/membri/$(request.auth.uid)).data.get('tk', '') != '';
    }
    // la chiave del ristorante: si crea una volta sola e nessuno la può leggere
    match /chiave/ristorante {
      allow create: if request.auth != null && request.resource.data.v is string && request.resource.data.v.size() >= 16
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow read, update, delete: if false;
    }
    // stato pubblico: dice solo se il database è già stato attivato
    match /pubblico/stato {
      allow read: if true;
      allow create: if request.auth != null && exists(/databases/$(db)/documents/chiave/ristorante);
      allow update, delete: if false;
    }
    // entrata libera: la legge chi è collegato, la cambia solo un telefono approvato e mai oltre 49 ore
    match /pubblico/porta {
      allow read: if request.auth != null;
      allow create, update: if membro() && request.resource.data.fino is int
        && request.resource.data.fino <= request.time.toMillis() + 49 * 3600 * 1000;
      allow delete: if membro();
    }
    // ogni telefono (accesso anonimo) si registra con la chiave e resta in attesa finché un telefono approvato non lo approva;
    // solo chi ha attivato il database entra subito. In attesa può solo scrivere la sua richiesta («req»).
    match /membri/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.k == get(/databases/$(db)/documents/chiave/ristorante).data.v
        && (request.resource.data.get('ok', true) == false
            || get(/databases/$(db)/documents/chiave/ristorante).data.get('uid', '') == request.auth.uid);
      allow read: if request.auth != null && (request.auth.uid == uid || membro());
      allow update: if request.auth != null && ((request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req'])) || membro()
        || (request.auth.uid == uid && portaAperta() && request.resource.data.ok == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'approvato', 'da']))
        || (request.auth.uid == uid && invitoBuono(request.resource.data.get('tk', '')) && request.resource.data.ok == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'approvato', 'da', 'tk', 'req'])
          && !existsAfter(/databases/$(db)/documents/inviti/$(request.resource.data.tk))));
      allow delete: if membro();
    }
    // inviti monouso: li crea un telefono approvato (al massimo 8 giorni); si legge solo conoscendo il gettone;
    // chi entra lo cancella nella stessa scrittura in cui si approva
    match /inviti/{tk} {
      allow get: if request.auth != null;
      allow list: if membro();
      allow create: if membro() && request.resource.data.sid is string && request.resource.data.fino is int
        && request.resource.data.fino <= request.time.toMillis() + 8 * 24 * 3600 * 1000;
      allow update: if false;
      allow delete: if membro() || (mioInvito()
        && getAfter(/databases/$(db)/documents/membri/$(request.auth.uid)).data.tk == tk);
    }
    // profilo creato con l'invito: chi entra con il gettone giusto mette la sua password e lo attiva, nella stessa scrittura
    match /staff/{sid} {
      allow update: if mioInvito() && resource.data.get('stato', '') == 'invitato'
        && request.resource.data.stato == 'attivo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pass', 'stato', 'attivato'])
        && get(/databases/$(db)/documents/inviti/$(getAfter(/databases/$(db)/documents/membri/$(request.auth.uid)).data.tk)).data.sid == sid;
    }
    // dati dell'app
    match /{c}/{id} {
      allow read, write: if membro() && c in ['staff', 'fornitori', 'listini', 'config', 'richieste', 'ordini', 'notifiche', 'backup', 'push', 'messaggi'];
    }
  }
}
